{
  "name": "studexa",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @studexa/mobile start",
    "dev:admin": "pnpm --filter @studexa/admin dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "supabase/tests/run-local.sh",
    "test:functions": "cd supabase/functions && deno test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "tests/integration/run.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "~6.0.3"
  }
}
