# Edge Function secrets. Locally: copy to supabase/functions/.env (git-ignored).
# Production: `npx supabase secrets set --env-file supabase/functions/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.

# 32+ random bytes, e.g. `openssl rand -base64 48`. Rotating it invalidates outstanding codes.
AUTH_CODE_PEPPER=

# resend | console (console prints emails to the log; development only)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Studexa <no-reply@your-domain.example>

# development | production
ENVIRONMENT=production
