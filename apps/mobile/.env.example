# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app —
# never put secrets (service role key, Anthropic key, RevenueCat secret) here.

# Supabase (Project Settings → API). Leave empty to run the app on mock data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (Google Cloud Console → Credentials → OAuth client IDs).
# The *Web* client id: the app requests an ID token for it, Supabase verifies it.
# Android also needs an "Android" client id registered with the app's SHA-1 (no value needed here).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only (future): iOS client id and its reversed form as URL scheme
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# Base URL of the legal pages (fallback when the server config is unreachable)
EXPO_PUBLIC_LEGAL_BASE_URL=https://voxabuilding15.github.io/my-

# RevenueCat public Android SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Force mock mode even when credentials are present (true/false)
EXPO_PUBLIC_USE_MOCKS=
