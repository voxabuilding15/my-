# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app —
# never put secrets (service role key, Anthropic key, RevenueCat secret) here.

# Supabase (Project Settings → API). Leave empty to run the app on mock data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (Google Cloud Console → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public Android SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Force mock mode even when credentials are present (true/false)
EXPO_PUBLIC_USE_MOCKS=
